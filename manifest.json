{
  "name": "Quicktimer",
  "description": "A simple timer for Google Chrome.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "hello.html",
    "default_icon": "sound.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [{
    "resources": ["alarm.mp3"],
    "matches": ["<all_urls>"]
  }]
}
